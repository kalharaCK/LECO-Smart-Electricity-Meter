PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Set DATABASE_SSL=false only for local PostgreSQL without TLS; production requires verified TLS.
DATABASE_SSL=true
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
FRONTEND_URL=http://localhost:5173
STAFF_FRONTEND_URL=http://localhost:5174
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TOKEN=replace_with_a_shared_random_service_secret
NODE_ENV=development

# PayHere Payment Gateway Credentials
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_MERCHANT_SECRET=your_merchant_secret
PAYHERE_SANDBOX=true
 
# Nodemailer / Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="LECO Smart Electricity" <no-reply@leco.lk>
